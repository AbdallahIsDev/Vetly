{
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!framer-scripts"]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "double",
            "arrowParentheses": "always",
            "trailingCommas": "es5"
        }
    },
    "linter": {
        "rules": {}
    },
    "overrides": [
        {
            "includes": ["Code-Components/BookingEngine.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noNoninteractiveElementToInteractiveRole": "off"
                    }
                }
            }
        }
    ]
}
